__pycache__/
*.pyc
.DS_Store
.claude/

# Reference microscopy images: large binaries, never commit.
# Provenance is tracked in ref_images/README.md instead.
*.czi
*.nd2
*.lif
*.vsi
*.ets
*.ome.tif
*.ome.tiff
ref_images/*.zip
ref_images/*.tif
ref_images/*.tiff
ref_images/*.jpg

# Pipeline outputs
.tmp/
analysis_output/
pilot_output/
test_runs/
ref_images/
*_TEST.groovy

# Whole-slide (WSI) Stage 1/2/3 artefacts. Stage 1 emits ~300-400 OME-TIFF
# tiles per slide (~9 GB) plus a companion ROI zip for every tile, and Stage 2
# writes ~20 files per tile. None of it belongs in git.
wsi_stage1*/
wsi_tiles/
tiles/
*_RoiSet.zip
RoiSet.zip
tile_manifest.csv
stage1_manifest.json
stage2_run_index*.json
slide_level_summary*.csv
mouse_level_summary.csv
group_level_summary.csv
# Bare TIFFs anywhere (masks, label images, exported tiles). The reference-image
# rules below are kept for provenance, but *.tif was previously only ignored
# under ref_images/, which left exported tiles committable.
*.tif
*.tiff

# Decoded-channel cache. scripts/cache_slide_channels.groovy writes the .vsi
# slides out at ds=8 as raw shorts (~1 GB for four slides) so the morphometry
# cross-check loads a slide in ~1.2 s instead of ~38 s. Verified bit-exact
# against a fresh decode, and regenerable from D:\Confocal_Images in ~10 min,
# so it is derived data that lives beside the code for convenience only.
# NEVER commit it: it is decoded image data, which this project does not track.
.cache/

# Built launcher artefacts at the repository root. build.ps1 writes the versioned
# .exe and its .sha256.txt sidecar here; a release belongs in GitHub Releases,
# not in git. Anchored to the root so the superseded binaries archived under
# legacy/launchers/ stay tracked.
/IFQuantLauncher-*.exe
/IFQuantLauncher-*.sha256.txt

# Local historical launcher copies moved out of the repository root during
# release packaging. Canonical distributables belong in GitHub Releases.
legacy/launchers/IFQuantLauncher-v1.9.1*.exe
legacy/launchers/IFQuantLauncher-v1.9.1*.sha256.txt

# Local legacy archives: indexed by legacy/README.md, binaries/results untracked.
legacy/test_runs/
legacy/pilot_output/
legacy/ref_images_analysis_output/

# Synthetic validation fixture (validation/): the scripts and README are
# tracked so a fresh clone can reproduce the blackBackground bug demo with no
# microscope data. Generated runtime outputs (fixture TIFF, world masks, logs)
# go to validation/out/ and stay ignored. The negations shield the tracked
# files from the global ignore rules above and from any future broad rule
# (last matching rule wins); they deliberately match only files directly under
# validation/, so nothing inside validation/out/ can ever be un-ignored.
validation/out/
!validation/*.groovy
!validation/*.ps1
!validation/README.md

# Derived whole-slide review snapshots. These are local inspection aids generated
# from microscopy data; keep them with run outputs rather than at repository root.
/wsi_slide*_review.png

# Generated whole-section overview panels. scripts/create_he_whole_section_overviews.py
# writes calibrated review PNGs plus a MANIFEST.json here; the manifest records
# local source paths and blind-to-mouse section mappings (unblinding data), so
# nothing under output/ may ever be committed.
/output/


# Local/private research material and credentials. Public source files may
# describe the study, but raw data, unblinding keys, review packages, local
# machine overrides, and presentation working files never belong in Git.
.env
.env.*
!.env.example
/local-private/
/private/
config/studies/*.local.json
config/brightfield/he_stain_profiles/*.local.json
**/INTERNAL_DO_NOT_SEND/
**/SEND_TO_REVIEWER/
**/*UNBLINDING_KEY*
*.ppt
*.pptx
*.oir
*.oib
*.svs
*.scn
