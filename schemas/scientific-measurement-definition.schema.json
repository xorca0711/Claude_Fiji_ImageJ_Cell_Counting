{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xorca0711/IFQuant-Lung/schemas/scientific-measurement-definition.schema.json",
  "title": "IFQuant backend-neutral scientific measurement definition",
  "description": "Pure numerical semantics for the initial calibrated 2-D area-fraction kernel. Threshold values, acquisition binding, execution provenance, governance, and conformance policy are separate contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "definition_type",
    "definition_id",
    "definition_version",
    "measurement_kind",
    "input_semantics",
    "processing_frame",
    "reference_space",
    "endpoint"
  ],
  "properties": {
    "$schema": {
      "const": "https://github.com/xorca0711/IFQuant-Lung/schemas/scientific-measurement-definition.schema.json"
    },
    "schema_version": { "const": "1.0.0" },
    "definition_type": {
      "const": "ifquant_scientific_measurement_definition"
    },
    "definition_id": { "$ref": "#/$defs/nonEmptyString" },
    "definition_version": { "$ref": "#/$defs/semanticVersion" },
    "measurement_kind": { "const": "area_fraction" },
    "input_semantics": { "$ref": "#/$defs/inputSemantics" },
    "processing_frame": { "$ref": "#/$defs/processingFrame" },
    "reference_space": { "$ref": "#/$defs/referenceSpace" },
    "endpoint": { "$ref": "#/$defs/endpoint" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "semanticInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "marker_id"],
      "properties": {
        "input_id": { "$ref": "#/$defs/nonEmptyString" },
        "marker_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "inputSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensionality",
        "plane_policy",
        "intensity_coordinate",
        "intensity_representation",
        "intensity_transform",
        "pixel_calibration",
        "pixel_area_unit",
        "semantic_inputs"
      ],
      "properties": {
        "dimensionality": { "const": "2d" },
        "plane_policy": { "const": "already_2d" },
        "intensity_coordinate": { "const": "native_sample_value" },
        "intensity_representation": { "const": "unsigned_integer" },
        "intensity_transform": { "const": "none" },
        "pixel_calibration": {
          "const": "required_axis_specific_source_metadata"
        },
        "pixel_area_unit": { "const": "um2" },
        "semantic_inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/semanticInput" }
        }
      }
    },
    "processingFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mask_construction_extent", "reference_intersection"],
      "properties": {
        "mask_construction_extent": {
          "const": "complete_supplied_plane_including_halo_if_present"
        },
        "reference_intersection": {
          "const": "after_component_filtering"
        }
      }
    },
    "referenceSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_space_id",
        "source",
        "artifact_role",
        "background_value",
        "foreground_value",
        "foreground_semantics"
      ],
      "properties": {
        "reference_space_id": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "const": "canonical_binary_mask" },
        "artifact_role": { "const": "reference_space_mask" },
        "background_value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "foreground_value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "foreground_semantics": { "const": "included_measurement_area" }
      }
    },
    "selectInputOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "parameters"],
      "properties": {
        "operation": { "const": "select_input" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_id"],
          "properties": {
            "input_id": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "gaussianBlurOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "parameters"],
      "properties": {
        "operation": { "const": "gaussian_blur" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sigma_x_pixels",
            "sigma_y_pixels",
            "border_mode",
            "kernel_accuracy",
            "intermediate_precision",
            "output_quantization"
          ],
          "properties": {
            "sigma_x_pixels": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sigma_y_pixels": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "border_mode": { "const": "nearest" },
            "kernel_accuracy": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.02
            },
            "intermediate_precision": { "const": "float32" },
            "output_quantization": {
              "enum": ["source_type", "float32"]
            }
          }
        }
      }
    },
    "thresholdOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "parameters"],
      "properties": {
        "operation": { "const": "apply_frozen_threshold" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threshold_parameter_id",
            "comparison",
            "foreground"
          ],
          "properties": {
            "threshold_parameter_id": { "$ref": "#/$defs/nonEmptyString" },
            "comparison": { "const": "greater_than_or_equal" },
            "foreground": { "const": "bright" }
          }
        }
      }
    },
    "componentFilterOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "parameters"],
      "properties": {
        "operation": { "const": "connected_component_filter" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectivity",
            "minimum_area_um2",
            "maximum_area_um2",
            "minimum_boundary",
            "maximum_boundary",
            "processing_extent",
            "edge_policy"
          ],
          "properties": {
            "connectivity": { "enum": [4, 8] },
            "minimum_area_um2": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximum_area_um2": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                { "type": "null" }
              ]
            },
            "minimum_boundary": { "enum": ["inclusive", "exclusive"] },
            "maximum_boundary": {
              "oneOf": [
                { "enum": ["inclusive", "exclusive"] },
                { "type": "null" }
              ]
            },
            "processing_extent": {
              "const": "complete_supplied_plane_including_halo_if_present"
            },
            "edge_policy": { "enum": ["include", "exclude"] }
          },
          "allOf": [
            {
              "if": {
                "properties": { "maximum_area_um2": { "type": "null" } },
                "required": ["maximum_area_um2"]
              },
              "then": {
                "properties": { "maximum_boundary": { "type": "null" } }
              },
              "else": {
                "properties": {
                  "maximum_boundary": { "enum": ["inclusive", "exclusive"] }
                }
              }
            }
          ]
        }
      }
    },
    "intersectionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "parameters"],
      "properties": {
        "operation": { "const": "intersect_reference_space" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_space_id"],
          "properties": {
            "reference_space_id": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "numeratorPipeline": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/selectInputOperation" },
        { "$ref": "#/$defs/gaussianBlurOperation" },
        { "$ref": "#/$defs/thresholdOperation" },
        { "$ref": "#/$defs/componentFilterOperation" },
        { "$ref": "#/$defs/intersectionOperation" }
      ],
      "items": false
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "const": "ratio_of_sums" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_id",
        "calculation",
        "numerator_unit",
        "denominator_unit",
        "result_unit",
        "denominator_source",
        "zero_numerator_policy",
        "zero_denominator_policy",
        "numerator_pipeline",
        "aggregation"
      ],
      "properties": {
        "endpoint_id": { "$ref": "#/$defs/nonEmptyString" },
        "calculation": { "const": "ratio" },
        "numerator_unit": { "const": "um2" },
        "denominator_unit": { "const": "um2" },
        "result_unit": { "const": "fraction" },
        "denominator_source": { "const": "reference_space" },
        "zero_numerator_policy": { "const": "observed_zero" },
        "zero_denominator_policy": { "const": "not_evaluable" },
        "numerator_pipeline": { "$ref": "#/$defs/numeratorPipeline" },
        "aggregation": { "$ref": "#/$defs/aggregation" }
      }
    }
  }
}
